[flake8]
max-line-length = 100
extend-ignore = 
    E203,
    W503,
    E501,
    F401,
    F403
exclude = 
    .git,
    __pycache__,
    .pytest_cache,
    .github,
    venv,
    env,
    .venv,
    Archive,
    reports
per-file-ignores =
    __init__.py:F401,F403
    tests/*:F401,F403,E501
max-complexity = 12
